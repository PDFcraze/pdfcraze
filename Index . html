```html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PDFcraze — Simple PDF tools</title>
  <meta name="description" content="Simple tools for working with PDF files.">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font: 16px/1.5 Arial, sans-serif;
      color: #202124;
      background: #f7f8fa;
    }
    header, main, footer { max-width: 1050px; margin: auto; padding: 24px; }
    header { display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 24px; font-weight: 700; color: #d93636; }
    .hero { text-align: center; padding: 48px 16px 28px; }
    h1 { margin-bottom: 8px; font-size: clamp(30px, 5vw, 46px); }
    .hero p { color: #60656d; }
    .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
    .tool {
      display: block; padding: 24px; border: 1px solid #e4e6e9;
      border-radius: 12px; background: white; color: inherit; text-decoration: none;
    }
    .tool:hover { border-color: #d93636; transform: translateY(-2px); }
    .icon { font-size: 30px; }
    .tool h2 { margin: 12px 0 6px; font-size: 20px; }
    .tool p { margin: 0; color: #60656d; }
    footer { margin-top: 32px; color: #60656d; font-size: 14px; }
    footer a { color: inherit; margin-right: 16px; }
  </style>
</head>
<body>
  <header>
    <div class="logo">PDFcraze</div>
    <span>Simple PDF tools</span>
  </header>

  <main>
    <section class="hero">
      <h1>PDF tools made simple</h1>
      <p>Choose a tool to get started. Your files stay on your device where supported.</p>
    </section>

    <section class="tools" aria-label="PDF tools">
      <a class="tool" href="#merge">
        <div class="icon" aria-hidden="true">📄</div>
        <h2>Merge PDF</h2>
        <p>Combine multiple PDF files into one.</p>
      </a>
      <a class="tool" href="#split">
        <div class="icon" aria-hidden="true">✂️</div>
        <h2>Split PDF</h2>
        <p>Separate pages from a PDF file.</p>
      </a>
      <a class="tool" href="#compress">
        <div class="icon" aria-hidden="true">🗜️</div>
        <h2>Compress PDF</h2>
        <p>Make a PDF file smaller where possible.</p>
      </a>
    </section>
  </main>

  <footer>
    <a href="mailto:contact@pdfcraze.example">Contact</a>
    <a href="#privacy">Privacy</a>
    <a href="#terms">Terms</a>
    <p>© 2026 PDFcraze</p>
  </footer>
</body>
</html>
